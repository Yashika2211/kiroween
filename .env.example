# Copy to .env and fill in. Never commit .env.

# GitHub token with `public_repo` scope (used for API metadata, forking and opening PRs).
GITHUB_TOKEN=

# LLM provider for the fix loop. Leave empty to run deterministic fixes only.
ANTHROPIC_API_KEY=
NECRO_LLM_MODEL=claude-opus-5-5

# Backend
NECRO_DB_PATH=./data/necromancer.sqlite3
NECRO_WORKSPACE_DIR=./data/workspaces
NECRO_MAX_LINES=5000
NECRO_MAX_FIX_ITERATIONS=3
NECRO_SANDBOX_IMAGE=python:3.12-slim
# "docker" (default, required for untrusted code) or "disabled"
NECRO_SANDBOX_MODE=docker
NECRO_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NECRO_RATE_LIMIT_PER_HOUR=20
