{
  "enabled": true,
  "name": "Accessibility review for new components",
  "description": "When a new React component is created, review it against the theme-and-tone accessibility rules.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": ["frontend/components/**/*.tsx"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the new component against .kiro/steering/theme-and-tone.md: reduced-motion support, keyboard access, visible focus, colour contrast, and that meaning is never conveyed by colour alone. List concrete fixes."
  }
}
